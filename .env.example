VITE_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<tu-clave-publica-o-anon>"
# Opcional si prefieres usar el nombre de clave anon
VITE_SUPABASE_ANON_KEY="<tu-clave-anon>"
# Opcional para el saludo del chatbot en configBotWeb (solo clave publishable/anon, nunca sb_secret)
VITE_SUPABASE_CONFIG_BOT_KEY="<tu-clave-publica-para-configBotWeb>"
VITE_SUPABASE_PROJECT_ID="<id-del-proyecto>"
# Mapa mundial de la carta de vinos (Mapbox GL). Si se deja vacío el mapa NO se
# monta y mapbox-gl (~458 KB gzip) no llega a descargarse. Token público "pk.*".
VITE_MAPBOX_TOKEN=""
# URL canónica del sitio: alimenta canonical, JSON-LD, sitemap.xml y robots.txt
VITE_SITE_URL="https://restaurantecasatomascrevillente.es"
# Place ID de la ficha de Google (enlace "dejar reseña" y `hasMap` del JSON-LD).
# Si se deja vacío se usa el verificado de Casa Tomás que hay en src/lib/negocio.ts
VITE_GOOGLE_PLACE_ID=""

# Chatbot "Pregunta a Tomy" visible al público (botón flotante y botón en el
# ticket del pedido). Solo "true" lo activa; sin definir u otro valor = oculto.
# Con el flag apagado, el equipo puede probarlo en la web real con ?tomy=1
# (se recuerda en la sesión; ?tomy=0 lo desactiva). Ver src/lib/featureFlags.ts
VITE_CHATBOT_PUBLICO=false
