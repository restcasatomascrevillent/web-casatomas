VITE_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<tu-clave-publica-o-anon>"
# Opcional si prefieres usar el nombre de clave anon
VITE_SUPABASE_ANON_KEY="<tu-clave-anon>"
# Opcional para el saludo del chatbot en configBotWeb
VITE_SUPABASE_CONFIG_BOT_KEY="<tu-clave-para-configBotWeb>"
VITE_SUPABASE_PROJECT_ID="<id-del-proyecto>"
