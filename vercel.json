{
  "ignoreCommand": "node scripts/vercel-produccion.mjs",
  "regions": ["fra1"],
  "cleanUrls": true,
  "redirects": [
    {"source": "/touza-cocktail{/}?", "destination": "/touza", "statusCode": 301},
    {"source": "/carta-casa-tomas-restaurante{/}?", "destination": "/carta", "statusCode": 301},
    {"source": "/politica-de-privacidad-y-accesibilidad{/}?", "destination": "/politica-privacidad", "statusCode": 301},
    {"source": "/politica-de-cookies{/}?", "destination": "/politica-privacidad#cookies", "statusCode": 301},
    {"source": "/sitemap_index.xml", "destination": "/sitemap.xml", "statusCode": 301},
    {"source": "/page-sitemap.xml", "destination": "/sitemap.xml", "statusCode": 301},
    {"source": "/reservar{/}?", "destination": "/reservas", "statusCode": 301},
    {"source": "/producto/:slug{/}?", "destination": "/regala", "statusCode": 301},
    {"source": "/carrito{/}?", "destination": "/regala", "statusCode": 301},
    {"source": "/finalizar-compra{/}?", "destination": "/regala", "statusCode": 301},
    {"source": "/touza-3{/}?", "destination": "/touza", "statusCode": 301},
    {"source": "/bases-legales-sorteo{/}?", "destination": "/", "statusCode": 301},
    {"source": "/reembolso_devoluciones{/}?", "destination": "/condiciones", "statusCode": 301},
    {"source": "/under-construction{/}?", "destination": "/", "statusCode": 301},
    {"source": "/:path(.+)/", "destination": "/:path", "statusCode": 301}
  ],
  "images": {
    "sizes": [640, 768, 1024],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "jeamoczmbfsnwkfjxcyo.supabase.co",
        "pathname": "^/storage/v1/object/public/.*$"
      },
      {
        "protocol": "https",
        "hostname": "haqmmdfdzzatdnrrcgez.supabase.co",
        "pathname": "^/storage/v1/object/public/.*$"
      },
      {
        "protocol": "https",
        "hostname": "sfonaclosuafvlhutkon.supabase.co",
        "pathname": "^/storage/v1/object/public/.*$"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' data: https://*.supabase.co https://api.mapbox.com https://events.mapbox.com; img-src 'self' data: blob: https:; worker-src blob:; object-src 'none'; base-uri 'self';" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), clipboard-write=(self), web-share=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/libre-baskerville/(.*).woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
