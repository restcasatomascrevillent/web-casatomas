# Plantilla para los secrets SECRETOS_FUNCIONES_PROD y SECRETOS_FUNCIONES_DEMO
# del repo restcasatomascrevillent/admin-casatomas (Settings → Secrets and
# variables → Actions). NO se guarda rellena en ningún repo: se copia, se
# rellena y se pega entera como valor del secret.
#
# Son exactamente los 31 secretos propios que tiene el proyecto viejo
# (jeamoczmbfsnwkfjxcyo) el 26-10-2026, sin contar los SUPABASE_* que pone la
# plataforma. Supabase no deja leer sus valores, así que salen de cada
# servicio. Cuando un servicio solo enseña la clave al crearla (Stripe,
# OpenAI, Resend), se crea una clave NUEVA en la misma cuenta: funciona igual.
#
# Línea vacía (NOMBRE=) = "no lo tengo": no se manda.

# ── A. Los genera el kit (no hace falta rellenarlos) ──────────────────────
# Secretos internos entre piezas de Casa Tomás. El kit los crea y pone los
# mismos valores en el Vault, que es de donde los leen los cron.
#   CHAT_WEB_IP_SALT, CHAT_WEB_SESSION_SECRET, EMAILS_RESERVA_SHARED_SECRET,
#   EMAILS_RESERVA_TOKEN_SECRET, NEWSLETTER_UNSUB_SECRET, OCR_TRABAJOS_SECRET,
#   RESERVAS_WEB_TOKEN_SECRET, TRAFICO_WEB_CRON_SECRET

# ── B. Claves de servicios externos (rellenar) ────────────────────────────

# Stripe → Developers → API keys. En DEMO: claves de modo test (sk_test_…).
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → el endpoint de los cheques → Signing secret.
# El día del corte se cambia la URL de ese endpoint al proyecto nuevo y el
# secreto sigue siendo el mismo. En DEMO: el de un endpoint de modo test.
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys / Webhooks. En DEMO, con copia completa de clientes
# reales: mejor dejar vacías RESEND_API_KEY y RESEND_MARKETING_API_KEY para que
# la demo no pueda escribir a clientes.
RESEND_API_KEY=
RESEND_MARKETING_API_KEY=
RESEND_WEBHOOK_SECRET=
# Remitente, p. ej.: Casa Tomás <reservas@tu-dominio-verificado>
RESEND_FROM_EMAIL=

# OpenAI → API keys (la del panel de administración, OPENAI_ADMIN_KEY, está
# en Organization → Admin keys). Una clave por proceso, para separar costes.
OPENAI_API_KEY=
OPENAI_API_KEY_CHAT=
OPENAI_API_KEY_CHATWEB=
OPENAI_API_KEY_OCR=
OPENAI_API_KEY_VINOS=
OPENAI_ADMIN_KEY=

# Google Cloud → Credentials (reseñas de Google).
GOOGLE_PLACES_API_KEY=
# Mapbox → Access tokens.
MAPBOX_ACCESS_TOKEN=

# Base de métricas (no se migra): la clave service_role de ese proyecto.
METRICS_SUPABASE_URL=https://yfnrkmxnmtrqmdtfvqix.supabase.co
METRICS_SUPABASE_SERVICE_ROLE_KEY=

# ── C. URLs y ajustes (ya rellenos para PROD; en DEMO, las de staging) ────
WEB_CASA_TOMAS_URL=https://web-casatomas.vercel.app
CHAT_WEB_ALLOWED_ORIGIN=https://web-casatomas.vercel.app,https://restaurantecasatomascrevillente.es,https://www.restaurantecasatomascrevillente.es
NEWSLETTER_BAJA_WEB_URL=https://web-casatomas.vercel.app/newsletter/baja
# "broadcast" (Resend Broadcasts) o "transaccional". Pon el que uséis ahora.
NEWSLETTER_CANAL=

# ── D. Vercel (los pongo yo cuando esté configurado el Vercel nuevo) ──────
#   VERCEL_DEPLOY_HOOK_CASA_TOMAS, VERCEL_DEPLOY_HOOK_TOUZA, VERCEL_ANALYTICS_TOKEN
