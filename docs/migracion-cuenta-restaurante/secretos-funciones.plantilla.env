# Plantilla para los secrets SECRETOS_FUNCIONES_PROD y SECRETOS_FUNCIONES_DEMO
# del repo restcasatomascrevillent/admin-casatomas (Settings → Secrets and
# variables → Actions). NO se guarda rellena en ningún repo: se copia, se
# rellena y se pega entera como valor del secret.
#
# Cómo rellenarla:
#   1. Abre el proyecto VIEJO en Supabase → Edge Functions → Secrets. Ahí ves
#      los NOMBRES que existen (los valores no se pueden ver).
#   2. Rellena aquí solo los que aparezcan allí. Los que no aparezcan, bórralos
#      o déjalos comentados con #: el código tiene su valor por defecto.
#   3. Los valores salen del panel de cada servicio (Stripe, Resend, OpenAI…)
#      o de donde los tengáis guardados.
#   4. Si un valor contiene la URL vieja (casa-tomas-story.vercel.app o
#      jeamoczmbfsnwkfjxcyo.supabase.co) déjala tal cual: el kit la cambia sola.
#
# No hace falta poner (los genera el kit, iguales en funciones y Vault):
#   EMAILS_RESERVA_SHARED_SECRET, EMAILS_RESERVA_TOKEN_SECRET,
#   RESERVAS_WEB_TOKEN_SECRET, OCR_TRABAJOS_SECRET, TRAFICO_WEB_CRON_SECRET,
#   NEWSLETTER_UNSUB_SECRET, NEWSLETTER_SYNC_CRON_SECRET,
#   CHAT_WEB_SESSION_SECRET, CHAT_WEB_IP_SALT
# Ni ninguno que empiece por SUPABASE_ (los pone Supabase).
# NUNCA poner RESERVAS_WEB_SHARED_SECRET: tira el formulario de reservas.

# ── A. Claves de servicios externos (las mismas cuentas de ahora) ──────────

# Stripe (cheques regalo). En DEMO: claves de modo test (sk_test_…).
STRIPE_SECRET_KEY=
# Es la del webhook NUEVO que se crea en Stripe apuntando al proyecto nuevo
# (ver README, fase 5). Si aún no existe, déjalo vacío y se añade después.
STRIPE_WEBHOOK_SECRET=

# Resend (correos de reservas y newsletter).
# En DEMO, con copia completa de clientes reales: mejor NO poner RESEND_API_KEY
# ni RESEND_MARKETING_API_KEY, para que la demo no pueda escribir a clientes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Es la del webhook NUEVO de Resend hacia el proyecto nuevo (fase 5).
RESEND_WEBHOOK_SECRET=
RESEND_MARKETING_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_NEWSLETTER_SEGMENT_ID_PRUEBA=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=
NEWSLETTER_EMAIL_PRUEBA=

# OpenAI y otras IA (OCR de facturas, chatbots, traducciones).
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
PERPLEXITY_API_KEY=
LOVABLE_API_KEY=

# Google: reseñas (Places) y facturas en Drive (OAuth).
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Teléfono (VAPI) y mapa.
VAPI_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Base de métricas yfnrkmxnmtrqmdtfvqix: NO se migra, se sigue usando la misma.
METRICS_SUPABASE_URL=
METRICS_SUPABASE_SERVICE_ROLE_KEY=

# n8n (traducción de novedades): la misma URL de webhook de ahora.
N8N_TRADUCIR_NOVEDAD_WEBHOOK=

# Emails de los superadministradores del panel, separados por comas.
SUPER_ADMIN_EMAILS=

# ── B. URLs de la cuenta nueva (ya rellenas para PROD; revisar) ────────────
# Mientras dure la prueba en paralelo, la web nueva vive en web-casatomas.vercel.app.
# El día del corte, cuando el dominio apunte al Vercel nuevo, se cambian.
# En DEMO, poner las URLs fijas de staging cuando existan.
WEB_CASA_TOMAS_URL=https://web-casatomas.vercel.app
CHAT_WEB_ALLOWED_ORIGIN=https://web-casatomas.vercel.app,https://restaurantecasatomascrevillente.es,https://www.restaurantecasatomascrevillente.es
EMAILS_RESERVA_ORIGENES_EXTRA=https://web-casatomas.vercel.app
CHEQUES_REGALO_SITE_URL=https://web-casatomas.vercel.app
# Touza: la URL nueva cuando exista su proyecto en el Vercel del restaurante.
# WEB_TOUZA_URL=

# ── C. Ajustes con valor por defecto en el código ─────────────────────────
