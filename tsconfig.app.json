{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /* `FacturaEmail.test.ts` y `AvisoCompraCheque.test.ts` importan código Deno de
     `supabase/functions/_shared/` (global `Deno`, imports `npm:` y `https:`) que este
     tsconfig del navegador no sabe tipar. Se siguen ejecutando en vitest; solo quedan
     fuera de este tsc. */
  "exclude": ["src/__tests__/FacturaEmail.test.ts", "src/__tests__/AvisoCompraCheque.test.ts"]
}
