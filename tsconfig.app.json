{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /* `FacturaEmail.test.ts` importa código Deno de `supabase/functions/_shared/`
     (global `Deno`, imports `npm:` y `https:`) que este tsconfig del navegador
     no sabe tipar. Se sigue ejecutando en vitest; solo queda fuera de este tsc. */
  "exclude": ["src/__tests__/FacturaEmail.test.ts"]
}
